# ==============================================================================
# D&D Campaign Notes - Environment Configuration
# ==============================================================================

# Supabase (Managed Cloud PostgreSQL & Realtime)
# Create a free project at https://supabase.com
# Find these under: Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Storage Backend Override (optional: "supabase", "github", or "local")
# If omitted and SUPABASE_URL is provided, "supabase" is automatically selected.
STORAGE_BACKEND="supabase"

# Local Obsidian Vault Path (optional - for local desktop development & sync)
OBSIDIAN_VAULT_PATH="C:\\Users\\icinc\\Documents\\Obsidian Vault\\Chris\\TTRPG\\D&D\\Starving Vilgeismar"

# Legacy GitHub REST API configuration (used only if STORAGE_BACKEND=github)
GITHUB_REPO="inchyc/dnd-campaign-note"
GITHUB_BRANCH="main"
GITHUB_TOKEN=""
